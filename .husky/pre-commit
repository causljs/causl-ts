#!/usr/bin/env sh
# pre-commit — full local-runnable union of CI checks across every
# workflow under .github/workflows/. Per user directive (chore/precommit
# CI-parity, mirrors the causl-wasm work in PR #59 on the sibling
# repo): pre-commit is the full CI-check set, not a fast-feedback
# subset. The interactive cost is paid in exchange for "if the hook
# passes, CI passes" certainty.
#
# Escape hatches:
#   - `SKIP_PRECOMMIT=1 git commit ...` — skip the hook body entirely
#     (useful for WIP commits on a personal branch).
#   - `git commit --no-verify` — git-native bypass; same effect.
#
# ─── CI ↔ pre-commit parity ──────────────────────────────────────────
#
# Workflow                                    Job(s) mirrored here
# ─────────────────────────────────────────── ────────────────────────
# main-fast.yml                               typecheck + build + lint
# bundle-budget.yml                           pnpm budget:test + pnpm size
# wasm.yml :: vendored-wasm                   pnpm wasm:verify:test
#                                             + pnpm wasm:verify
# vendor-manifest.yml          (paths-filt.)  scripts/check-vendor-manifest.sh
#
# Deferred to .husky/pre-push (heavier, network-adjacent):
#   - e2e/bundler-interop/ — npm install + bundler builds + verify
#     (mirrors wasm.yml's `bundler-interop` job).
#
# NOT mirrored locally:
#   - cross-backend-fuzz.yml                   — nightly cron only
#   - release.yml                              — tag publish gate
#
# The `wasm.yml` cargo-check and wasm-pack rows that used to sit here are gone.
# Those jobs were removed in #49 because the crates and the build driver they
# detect are not in this repository, so they had nothing to mirror. The
# four-way-classifier row went with them; that workflow is parked (#47).
#
# Each step prints a banner so a failed hook surfaces WHICH gate
# failed without scrolling.

if [ "${SKIP_PRECOMMIT:-0}" = "1" ]; then
  echo "pre-commit: SKIP_PRECOMMIT=1 set — skipping all hooks"
  exit 0
fi

set -e

# 0. lint-staged — eslint --fix on staged TS sources (auto-fix pass
#    that re-stages corrected bytes before the workspace-wide lint).
#    Kept first so the workspace `pnpm lint` below sees the fixed
#    files rather than re-flagging them.
echo "pre-commit [0/9]: lint-staged (eslint --fix on staged TS files)"
pnpm exec lint-staged

# 1. Typecheck — mirrors main-fast.yml `Type check` step.
echo "pre-commit [1/9]: pnpm typecheck (mirrors main-fast.yml)"
pnpm typecheck

# 2. Build — mirrors main-fast.yml `Build packages` step. Also a
#    prerequisite for `pnpm size` and `e2e/bundler-interop` (the
#    size-limit cells read packages/<name>/dist/*).
echo "pre-commit [2/9]: pnpm build (mirrors main-fast.yml; required by size gate)"
pnpm build

# 3. Lint — mirrors main-fast.yml `Lint` step. Workspace-wide so
#    cross-file rules (e.g. causl/no-graph-upcast per #9) see the
#    full graph, not just the staged-files subset lint-staged saw.
echo "pre-commit [3/9]: pnpm lint (mirrors main-fast.yml)"
pnpm lint

# 4-5. Bundle budget — mirrors bundle-budget.yml. The reporter's own
#    unit cover runs first, then the 11 size-limit cells in root
#    package.json against the dist/ artefacts produced in step 2. The
#    #22 overage this step used to carry a carve-out for closed in PR
#    #23 and #39, so the gate is live rather than advisory.
echo "pre-commit [4/9]: pnpm budget:test (bundle-budget reporter unit cover)"
pnpm budget:test

echo "pre-commit [5/9]: pnpm size (mirrors bundle-budget.yml)"
pnpm size

# 6-7. Vendored wasm — mirrors wasm.yml's `vendored-wasm` job. Both
#    steps are node:test / plain node with no toolchain, so unlike the
#    wasm-pack matrix they replaced these do run locally.
echo "pre-commit [6/9]: pnpm wasm:verify:test (verifier unit cover)"
pnpm wasm:verify:test

echo "pre-commit [7/9]: pnpm wasm:verify (committed .wasm bytes + ceilings)"
pnpm wasm:verify

# 8. @causlts/core/testing tarball-consumer typecheck — mirrors
#    main-fast.yml's `#31 regression` step. Fast (pack + npm install
#    of a single tarball + tsc on one tiny file, ~5-10s). Catches
#    `dist/testing.d.ts` regressing back to an unresolvable external
#    re-export (the #31 class of bug).
echo "pre-commit [8/9]: #31 regression — pack-and-typecheck @causlts/core/testing (mirrors main-fast.yml)"
bash scripts/check-core-testing-types.sh

# 9. Vendor-manifest — mirrors vendor-manifest.yml. Paths-filtered
#    to match the workflow: only fires when vendored bytes or the
#    refresh/check scripts are part of the staged set.
echo "pre-commit [9/9]: vendor-manifest gate (mirrors vendor-manifest.yml)"
if git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^(causl-org/vendor/|scripts/(refresh|check)-vendor-manifest\.sh$)' \
    > /dev/null; then
  echo "pre-commit: vendor paths staged — running scripts/check-vendor-manifest.sh"
  bash scripts/check-vendor-manifest.sh
else
  echo "pre-commit: no vendor paths staged — skipping (matches workflow paths: filter)"
fi

echo "pre-commit: all gates green ✓"
